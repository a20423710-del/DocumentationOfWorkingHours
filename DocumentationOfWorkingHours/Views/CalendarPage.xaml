<ContentPage x:Name="page" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DocumentationOfWorkingHours.Views.CalendarPage"
             Title="Working Hours">

    <ContentPage.Resources>
        <!-- DayTextColor removed; use ShellTitleColor resource directly in TextColor bindings -->
        <Style x:Key="DayBorder" TargetType="Border">
            <Setter Property="Padding" Value="6" />
            <!--<Setter Property="CornerRadius" Value="6" />-->
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Stroke" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
        </Style>
        <Style x:Key="PlaceholderBorder" TargetType="Border" BasedOn="{StaticResource DayBorder}">
            <Setter Property="Opacity" Value="0.2" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Spacing="6" Padding="8">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
            <Button Text="◀" Command="{Binding PrevMonthCommand}" />
            <Label Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" Text="{Binding MonthTitle}" />
            <Button Grid.Column="2" Text="▶" Command="{Binding NextMonthCommand}" />
        </Grid>

        <!-- Wochentage -->
        <Grid ColumnDefinitions="*,*,*,*,*,*,*">
            <Label Text="MO" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Text="DI" Grid.Column="1" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Text="MI" Grid.Column="2" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Text="DO" Grid.Column="3" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Text="FR" Grid.Column="4" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Text="SA" Grid.Column="5" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Text="SO" Grid.Column="6" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- Calendar -->
        <Grid ColumnDefinitions="*" ColumnSpacing="8">
            <!-- Tage als Grid (7 Spalten) -->
            <CollectionView Grid.Column="0" ItemsSource="{Binding Days}" SelectionMode="Single" SelectedItem="{Binding SelectedDay, Mode=TwoWay}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DayBorder}" BackgroundColor="Transparent">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Day number centered -->
                                <Label Grid.Row="0" Text="{Binding DayNumber}" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" />

                                <!-- Note at bottom-left -->
                                <Label Grid.Row="1" Text="{Binding Note}" FontSize="11" VerticalOptions="End" HorizontalOptions="Start" LineBreakMode="TailTruncation" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference page}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsPlaceholder}" Value="True">
                                    <Setter Property="Style" Value="{StaticResource PlaceholderBorder}" />
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="InputTransparent" Value="True" />
                                </DataTrigger>
                                <!-- Thin white border for current day -->
                                <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                    <Setter Property="Stroke" Value="White" />
                                    <Setter Property="StrokeThickness" Value="1" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Weekly sums removed -->
        </Grid>

        <!-- Eingabebereich und Wochen-Summen in einer Zeile -->
        <Grid Padding="6" ColumnDefinitions="*,Auto" VerticalOptions="Center">
            <!-- Week sums moved to the left column -->
            <Label Grid.Column="0" Text="{Binding WeekSumsText}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                   TextColor="{StaticResource PrimaryDark}"
                   Padding="8"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   Margin="12,0,12,0"
                   LineBreakMode="NoWrap" />

            <!-- Hours controls moved to the right column -->
            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center" HorizontalOptions="End">
                <Label Text="{Binding SelectedHours, StringFormat='{0:N1}h'}" VerticalOptions="Center" IsVisible="{Binding IsEditing}" HorizontalOptions="Center" />

                <Button Text="-" WidthRequest="44" HeightRequest="44" Clicked="OnMinusClicked" IsVisible="{Binding IsEditing}" />
                <Button Text="+" WidthRequest="44" HeightRequest="44" Clicked="OnPlusClicked" IsVisible="{Binding IsEditing}" />

                <Button Text="Save" Command="{Binding SaveCommand}" IsVisible="{Binding IsEditing}" IsEnabled="{Binding IsEditing}" />
            </HorizontalStackLayout>
        </Grid>

    </VerticalStackLayout>
</ContentPage>