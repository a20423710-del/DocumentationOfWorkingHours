<ContentPage x:Name="page" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DocumentationOfWorkingHours.Views.CalendarPage"
             Title="Working Hours">

    <ContentPage.Resources>
        <!-- DayTextColor removed; use ShellTitleColor resource directly in TextColor bindings -->
        <Style x:Key="DayBorder" TargetType="Border">
            <Setter Property="Padding" Value="6" />
            <!--<Setter Property="CornerRadius" Value="6" />-->
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Stroke" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
        </Style>
        <Style x:Key="PlaceholderBorder" TargetType="Border" BasedOn="{StaticResource DayBorder}">
            <Setter Property="Opacity" Value="0.2" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Spacing="6" Padding="8">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
            <Button Text="◀" Command="{Binding PrevMonthCommand}" />
            <Label Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" Text="{Binding MonthTitle}" />
            <Button Grid.Column="2" Text="▶" Command="{Binding NextMonthCommand}" />
        </Grid>

        <!-- Wochentage -->
        <Grid ColumnDefinitions="*,*,*,*,*,*,*">
            <Label Text="MO" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Text="DI" Grid.Column="1" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Text="MI" Grid.Column="2" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Text="DO" Grid.Column="3" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Text="FR" Grid.Column="4" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Text="SA" Grid.Column="5" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Text="SO" Grid.Column="6" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- Calendar -->
        <Grid ColumnDefinitions="*" ColumnSpacing="8">
            <!-- Tage als Grid (7 Spalten) -->
            <CollectionView Grid.Column="0" ItemsSource="{Binding Days}" SelectionMode="Single" SelectedItem="{Binding SelectedDay, Mode=TwoWay}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DayBorder}" BackgroundColor="Transparent">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Day number centered -->
                                <Label Grid.Row="0" Text="{Binding DayNumber}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsOtherMonth}" Value="True">
                                            <Setter Property="TextColor" Value="Gray" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsOtherMonth}" Value="False">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Note at bottom-left (worked hours) -->
                                <Label Grid.Row="1" Text="{Binding DisplayNote}" FontSize="11" VerticalOptions="End" HorizontalOptions="Start" LineBreakMode="TailTruncation">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsOtherMonth}" Value="True">
                                            <Setter Property="TextColor" Value="Gray" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsOtherMonth}" Value="False">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference page}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsPlaceholder}" Value="True">
                                    <Setter Property="Style" Value="{StaticResource PlaceholderBorder}" />
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="InputTransparent" Value="True" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsOtherMonth}" Value="True">
                                    <!-- Visual style for other-month cells: show but de-emphasize and disable interaction -->
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="InputTransparent" Value="True" />
                                </DataTrigger>
                                <!-- Thin white border for current day -->
                                <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                    <Setter Property="Stroke" Value="White" />
                                    <Setter Property="StrokeThickness" Value="1" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Weekly sums removed -->
        </Grid>

        <!-- Eingabebereich und Wochen-Summen in einer Zeile -->
        <!-- Reserve fixed space for the hours controls column so showing/hiding it does not shift the week labels -->

        <!-- All bottom controls in one single horizontal line -->
        <HorizontalStackLayout Spacing="12" Padding="6" VerticalOptions="End" HorizontalOptions="Fill" BackgroundColor="Transparent">
            <!-- Week summaries (left) -->
            <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="StartAndExpand" VerticalOptions="Center" BindableLayout.ItemsSource="{Binding WeekSummaries}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Orientation="Vertical" Spacing="2" Margin="0">
                            <Label Text="{Binding Label}"
                                   Padding="4,2"
                                   Margin="4,0"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                                   TextColor="{Binding TextColor}"
                                   VerticalOptions="Center" />
                            <ProgressBar Progress="{Binding Progress}" HeightRequest="6" ProgressColor="{Binding ProgressColor}" BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        </StackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>

            <!-- Total hours -->
            <Label Text="{Binding TotalHours, StringFormat='Total hours: {0:N1} h'}"
                   TextColor="{AppThemeBinding Light={StaticResource ShellTitleColor}, Dark={StaticResource PrimaryDark}}"
                   VerticalOptions="Center" HorizontalOptions="Center" />

            <!-- Timer (right) - value on top of the buttons (moved left) -->
            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="{Binding TimerDisplay}" FontAttributes="Bold" HorizontalOptions="Center" />
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Button Text="{Binding TimerStartButtonText}" Command="{Binding TimerStartCommand}" WidthRequest="96" HeightRequest="44" />
                    <Button Text="Stop" Command="{Binding TimerStopCommand}" WidthRequest="64" HeightRequest="44" />
                    <Button Text="Reset" Command="{Binding TimerResetCommand}" WidthRequest="64" HeightRequest="44" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Selected hours and edit controls: value shown above the buttons (moved right) -->
            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                <Label Text="{Binding SelectedHoursDisplay}" HorizontalOptions="Center" />
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                    <Button Text="-" WidthRequest="44" HeightRequest="44" Clicked="OnMinusClicked" />
                    <Button Text="+" WidthRequest="44" HeightRequest="44" Clicked="OnPlusClicked" />
                    <Button Text="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsEditing}" HeightRequest="44" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>
